# --- console: UART0 = the CH343 USB port ---
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# --- flash layout: 4MB works on 4MB and 8MB C6 boards ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- 1 ms ticks, so the packet period (1000 / RATE ms) is exact ---
CONFIG_FREERTOS_HZ=1000

# --- home WiFi: set per board over serial (STASSID:/STAPASS:), never committed ---
CONFIG_STA_SSID=""
CONFIG_STA_PASSWORD=""

# --- sensing: ESP-NOW broadcast rate ---
CONFIG_PACKET_RATE=100

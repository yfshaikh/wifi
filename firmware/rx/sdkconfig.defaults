# --- console: UART0 = the CH343 USB port. High baud so CSI lines keep up ---
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# --- flash layout: 4MB works on 4MB and 8MB C6 boards; 1.5MB app partition ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- required by the CSI capture path ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_CSI_ENABLED=y

# --- home WiFi: set per board over serial (STASSID:/STAPASS:), never committed ---
CONFIG_STA_SSID=""
CONFIG_STA_PASSWORD=""

# --- debug: also print every CSI record on USB serial ---
CONFIG_SEND_CSI_TO_SERIAL=y

# --- reporting network (MQTT), defaults used if not overridden via serial ---
CONFIG_NODE_ID="rx-1"
CONFIG_MQTT_HOST=""
CONFIG_MQTT_PORT=1883
CONFIG_MQTT_TOPIC="csi"

# Plaintext MQTT to a local broker only -> drop the TLS/websocket transports.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n
